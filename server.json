{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.appforshare/appforshare",
  "title": "AppForShare",
  "description": "Share iOS and Android test builds: upload, install links, testers, store readiness and releases.",
  "websiteUrl": "https://appforshare.io/docs/mcp",
  "repository": {
    "url": "https://github.com/appforshare/appforshare-mcp",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://appforshare.io/icons/AppForShare-icon-dark-512.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "version": "1.0.7",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://appforshare.io/api/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "appforshare-mcp",
      "version": "1.0.7",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "APPFORSHARE_TOKEN",
          "description": "AppForShare API token (Settings, API tokens; Pro and Team)",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
